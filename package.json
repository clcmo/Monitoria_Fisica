{
  "name": "monitoria-fisica",
  "version": "0.0.0-development",
  "description": "Template de projeto para publicação com Semantic Release",
  "repository": {
    "type": "git",
    "url": "https://github.com/clcmo/template.git"
  },
  "author": "Camila <milla@apprendendo.blog>",
  "license": "MIT",
  "scripts": {
    "release": "semantic-release",
    "dev": "vite",
    "build": "tsc && vite build",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "preview": "vite preview"
  },
  "publishConfig": {
    "access": "public"
  },
  "release": {
    "branches": [
      "main"
    ]
  },
  "devDependencies": {
    "typescript": "^5.2.2",
    "@semantic-release/changelog": "^6.0.0",
    "@semantic-release/git": "^10.0.0",
    "@semantic-release/github": "^9.0.0",
    "@semantic-release/npm": "^13.1.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "gh-pages": "^6.3.0",
    "semantic-release": "^25.0.9",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
